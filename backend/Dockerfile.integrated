# Dockerfile for integrated backend with frontend assets
# This Dockerfile builds both the backend and includes the frontend static files

# Stage 1: Build the backend
FROM alpine:3.18 AS backend-builder

# Install Zig and dependencies
RUN apk add --no-cache \
    curl \
    tar \
    xz \
    musl-dev \
    gcc

# Download and install Zig 0.14.1
RUN curl -L https://ziglang.org/download/0.14.1/zig-x86_64-linux-0.14.1.tar.xz -o zig.tar.xz && \
    tar -xf zig.tar.xz && \
    mv zig-x86_64-linux-0.14.1 /usr/local/zig && \
    ln -s /usr/local/zig/zig /usr/local/bin/zig

# Set working directory
WORKDIR /app

# Copy backend build files
COPY build.zig build.zig.zon ./
COPY src ./src

# Build the backend application
RUN zig build -Doptimize=ReleaseFast

# Stage 2: Build the frontend
FROM node:20-alpine AS frontend-builder

# Set working directory
WORKDIR /app

# Copy package files
COPY ../inventorus-frontend/package.json ../inventorus-frontend/package-lock.json ./

# Install dependencies
RUN npm ci

# Copy frontend source
COPY ../inventorus-frontend/ ./

# Build the frontend
RUN npm run build

# Stage 3: Production image with both backend and frontend
FROM alpine:3.18

# Install runtime dependencies
RUN apk add --no-cache sqlite

# Create app user
RUN addgroup -g 1001 -S appgroup && \
    adduser -S -D -H -u 1001 -h /app -s /sbin/nologin -G appgroup appuser

# Set working directory
WORKDIR /app

# Copy the built backend executable
COPY --from=backend-builder /app/zig-out/bin/zig_api_test ./zig_api_test

# Copy the built frontend assets
COPY --from=frontend-builder /app/build ./frontend

# Create a simple index.html that includes the frontend assets
RUN mkdir -p /app/src/html && \
    cat > /app/src/html/index.html << 'EOF'
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inventorus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet" />
    <script>
        (function() {
          console.log('Loading env-config.js...');
          window.INVENTORUS_API_ADDRESS = '/';
          console.log('Runtime API address set to:', window.INVENTORUS_API_ADDRESS);
        })();
    </script>
</head>
<body>
    <div id="root"></div>
    <script type="module">
        // This is a placeholder - in a real implementation, you'd include the actual React app
        // For now, we'll create a simple interface
        document.getElementById('root').innerHTML = `
            <div style="font-family: Inter, sans-serif; padding: 20px; max-width: 800px; margin: 0 auto;">
                <h1>Inventorus - Component Inventory System</h1>
                <p>Backend is running! API endpoints available:</p>
                <ul>
                    <li><a href="/api/components/">GET /api/components/</a> - List all components</li>
                    <li><a href="/api/vendors/">GET /api/vendors/</a> - List all vendors</li>
                    <li><a href="/api/types/">GET /api/types/</a> - List all types</li>
                    <li><a href="/api/test">GET /api/test</a> - Health check</li>
                </ul>
                <div id="components-list" style="margin-top: 20px;">
                    <h2>Components:</h2>
                    <div id="components-data">Loading...</div>
                </div>
                <script>
                    // Simple API test
                    fetch('/api/components/')
                        .then(response => response.json())
                        .then(data => {
                            document.getElementById('components-data').innerHTML =
                                '<pre>' + JSON.stringify(data, null, 2) + '</pre>';
                        })
                        .catch(error => {
                            document.getElementById('components-data').innerHTML =
                                'Error: ' + error.message;
                        });
                </script>
            </div>
        `;
    </script>
</body>
</html>
EOF

# Change ownership
RUN chown -R appuser:appgroup /app

# Create data directory with proper permissions
RUN mkdir -p /app/data && chmod 777 /app/data

# Switch to non-root user
USER appuser

# Expose port 8080 only
EXPOSE 8080

# Run the application
CMD ["./zig_api_test"]
